# share Pod の caddy (just share を常駐させる構成、docs/cluster/share.md)。cloudflared の 3 本のトンネルが 3 つのポートに入り、
# 認証サービス (share_auth.py、127.0.0.1:9000) を通った要求にだけ、対象ごとの許可リストを掛けて upstream に渡す。
#   :8081 grafana    :8082 headroom (ホストの中継経由)    :8083 backstage
# 順序は固定: 認証が通らなければ経路を問わず 401 (経路の存在を探らせない)、通ったあとで許可リストの外が 404。
# 特権 viewer も期限付きも同じ表を通る (見られる範囲に差をつけない)。
#
# Grafana に渡す viewer の鍵 (Basic) は、環境変数では持たない (#58)。認証サービスが要求ごとに Secret share-grafana を (最大 2 秒の覚えで) 読んで
# Basic の値を組み、通った応答の X-Share-Grafana-Authorization に載せる。caddy はそれを Grafana への Authorization にする。
# パスワードを変えても share の再起動 (= Quick Tunnel の URL の変更) は要らない。人の Authorization・Cookie は Grafana に渡さない。
#
# 環境変数 (Deployment が渡す。#41。{$VAR} で既定の無いものは、空だと起動しない):
#   SHARE_RELAY_TOKEN    headroom の中継 (just/share-relay.Caddyfile) の共有トークン (Secret share-host)
#   SHARE_RELAY_ADDR     中継の <bridge のゲートウェイ>:<ポート> (Secret share-host。例 172.18.0.1:8788)
#   SHARE_AUTH_ADDR      認証サービス (既定 127.0.0.1:9000)
#   SHARE_GRAFANA_UPSTREAM / SHARE_BACKSTAGE_UPSTREAM  既定は Service (grafana.observability.svc:80 / backstage.backstage.svc:7007)。試験が偽の upstream に向ける
#   SHARE_GRAFANA_PORT / SHARE_HEADROOM_PORT / SHARE_BACKSTAGE_PORT  待ち受け (既定 8081 / 8082 / 8083)。待ち受けは 127.0.0.1 だけ (同じ Pod の cloudflared からだけ届く)
{
	admin off
	auto_https off
}

# 必須の環境変数が空なら、起動しない (空の Basic や空のトークンで、認証が抜けたまま立ち上がらない)。caddy は {$VAR} が空でも
# 通すが、header の matcher は値が空だと設定の読み込みで落ちるので、それを番人に使う (just/share-relay.Caddyfile も同じ)
(require_env) {
	@required_env header X-Share-Required {$SHARE_RELAY_TOKEN}
	@required_env2 header X-Share-Required {$SHARE_RELAY_ADDR}
}

# 認証。認証サービスに「同じ要求」(Authorization・Cookie をそのまま) を GET で聞く。2xx 以外 (401) はその応答をそのまま返し、
# 以降の許可リストにも upstream にも進まない。forward_auth の短縮形は、認証サービスの応答のヘッダを upstream への要求に
# 写すだけで、クライアントへの応答には載せられない。署名つき cookie の Set-Cookie (Basic で通ったときだけ付く。Backstage の
# Bearer の API 呼び出しは cookie で通る) を載せるため、forward_auth の中身を書き下し、2xx の分岐で Set-Cookie を応答に載せる。
# 同じ分岐で、X-Share-Grafana-Authorization (Grafana の経路を聞いたときだけ、認証サービスが付ける viewer の Basic) を要求に写す。
# 応答に無い (空の) ときは写さない: 照合は forward_auth の copy_headers と同じ vars (placeholder が空かどうか)。expression の != "" は、
# 無いヘッダでも真になり、空のヘッダを要求に付けてしまう (headroom・backstage の upstream にも空の X-Share-Grafana-Authorization が届く)。
# 引数は対象 (grafana・headroom・backstage)。認証サービスは X-Share-Target を見て、grafana のときだけ Basic を返し、返せなければ 503 にする。
# 人が付けてきた X-Share-Grafana-Authorization は、認証サービスの応答のものと取り違えないよう、先に消す (どの経路でも)。
# X-Share-Target は header_up が人の値を置き換えるので、人は対象を偽れない
(share_auth) {
	request_header -X-Share-Grafana-Authorization
	reverse_proxy {$SHARE_AUTH_ADDR:127.0.0.1:9000} {
		method GET
		rewrite /
		header_up X-Forwarded-Method {method}
		header_up X-Forwarded-Uri {uri}
		header_up X-Share-Target {args[0]}
		@authenticated status 2xx
		handle_response @authenticated {
			@cookie expression `{rp.header.Set-Cookie} != ""`
			header @cookie +Set-Cookie {rp.header.Set-Cookie}
			@viewer not vars {rp.header.X-Share-Grafana-Authorization} ""
			request_header @viewer X-Share-Grafana-Authorization {rp.header.X-Share-Grafana-Authorization}
		}
	}
}

# Grafana の root_url は http://localhost:3000/ のままなので、短縮リンク (/goto/<uid>) などは Location: http://localhost:3000/... を
# 返す。別の PC のブラウザではそれがその PC 自身を指して開けないので、相対パスに書き換える。
# Host はそのまま渡す (Grafana のログイン時の Origin 確認が Host と比べるため)
http://:{$SHARE_GRAFANA_PORT:8081} {
	bind 127.0.0.1
	import require_env
	route {
		import share_auth grafana
		# viewer のパスワードを人が変えて他の人を締め出せないようにする
		@password path /profile/password /profile/password/ /api/user/password /api/user/password/
		respond @password 404
		# viewer は自分のプロフィールを書き換えられる。PUT /api/user でログイン名を変えると、caddy が付ける
		# Basic (viewer:<パスワード>) が効かなくなり、共有が全員分壊れる (#51)。viewer は共有相手全員で 1 人なので、
		# /api/user 以下 (プロフィール・preferences・org の切り替え・星) と、同じ preferences の新しい API
		# (/apis/preferences.grafana.app) は読み取りだけ通し、書き込みは 404 (Grafana 13.2 で viewer の書き込みを確かめた)
		@user_write {
			path /api/user /api/user/* /apis/preferences.grafana.app/*
			not method GET HEAD
		}
		respond @user_write 404
		# 認証が通ったのに viewer の鍵が付いていない (Secret share-grafana が無い・空で、認証サービスが読めない) ときは通さない。
		# 鍵が無いまま渡すと、人の Authorization がそのまま Grafana に届いてしまう (認証サービスの 503 の二重の止め)
		@no_viewer vars {http.request.header.X-Share-Grafana-Authorization} ""
		respond @no_viewer 503
		reverse_proxy {$SHARE_GRAFANA_UPSTREAM:grafana.observability.svc:80} {
			# 人の資格情報 (Authorization) は渡さず、認証サービスが応答した viewer の鍵に差し替える (Set は人の値を全部置き換える)。
			# 鍵を運んだ X-Share-Grafana-Authorization 自身と、share_session の cookie も渡さない
			header_up Authorization {http.request.header.X-Share-Grafana-Authorization}
			header_up -X-Share-Grafana-Authorization
			header_up -Cookie
			header_down Location ^http://localhost:3000/ /
		}
	}
}

# headroom は同じポートでプロキシ本体 (/v1/messages など。手元の Anthropic の認証を使って転送する) とダッシュボードを返すので、
# ダッシュボードが使う読み取りの GET だけを、ホストの中継 (トークン付き) に渡す。中継も同じ許可リストを掛ける (二重)。
# HEAD は通さない: 実機の headroom は許可リストの経路の HEAD に 404 を返し、Anthropic へ素通しするとみられる (#48)
http://:{$SHARE_HEADROOM_PORT:8082} {
	bind 127.0.0.1
	route {
		import share_auth headroom
		# path の matcher は大文字小文字を区別しない (/Health も /health として通る)。headroom は区別するので、
		# 表記揺れの経路がプロキシ本体の受け口に落ちうる。許可は path_regexp (区別する・全体一致) で書く (#53)
		@dashboard {
			method GET
			path_regexp dash ^/(dashboard|health|stats|stats-history|stats-lifetime|transformations/feed|favicon\.ico)$
		}
		handle @dashboard {
			# path_regexp は caddy が整えた path に当たるが、reverse_proxy は生の path を送る。/x/../health のようなドットセグメントが
			# そのまま headroom に届かないよう、許可した経路そのものに書き換えて渡す (クエリは残る)
			rewrite * /{re.dash.1}
			reverse_proxy {$SHARE_RELAY_ADDR} {
				header_up X-Share-Relay-Token {$SHARE_RELAY_TOKEN}
				# 人の資格情報・cookie は中継にも headroom にも渡さない
				header_up -Authorization
				header_up -Cookie
			}
		}
		respond 404
	}
}

# Backstage はバックエンドのプロキシ (/api/proxy/grafana/api) で Grafana の API を、Backstage が持つ資格情報で読む。
# また POST /api/catalog/locations は、外からカタログに任意の URL を読ませる。画面と TechDocs を読むのに要る経路だけを通す。
#   GET・HEAD: /api/proxy 以外はすべて (画面・カタログ・TechDocs の読み取り)
#   POST: ゲストのログイン (/api/auth/*) と、カタログのエンティティの一括取得 (/api/catalog/entities/by-refs) だけ
# 画面の API 呼び出しは Authorization: Bearer (Backstage のトークン) を付けるので、Basic は最初のページの読み込みでしか使えない。
# Basic で通ると認証サービスの署名つき cookie (share_session) が付き、以後は cookie で通る
(backstage_cookie) {
	# TechDocs の文書の CSS や画像は cookie (backstage-auth) で認証する。Backstage はその cookie に backend.baseUrl の
	# ホスト名 (Domain=localhost) を付けるので、trycloudflare のホストではブラウザが捨てて文書が表示されない。Domain を外す
	header_down Set-Cookie "; Domain=localhost" ""
}

http://:{$SHARE_BACKSTAGE_PORT:8083} {
	bind 127.0.0.1
	@read {
		method GET HEAD
		not path /api/proxy /api/proxy/*
	}
	# POST の許可は大文字小文字を区別して全体一致にする (path は区別しない。#53)。拒否側の /api/proxy は区別しない
	# path のままにして、/api/PROXY のような表記揺れも止める
	@write {
		method POST
		path_regexp ^/api/auth/.*$|^/api/catalog/entities/by-refs$
	}
	@basic header Authorization "Basic *"
	route {
		import share_auth backstage
		# Basic の資格情報は Backstage に渡さない (Backstage は Bearer のトークンだけを見る)
		request_header @basic -Authorization
		reverse_proxy @read {$SHARE_BACKSTAGE_UPSTREAM:backstage.backstage.svc:7007} {
			import backstage_cookie
		}
		reverse_proxy @write {$SHARE_BACKSTAGE_UPSTREAM:backstage.backstage.svc:7007} {
			import backstage_cookie
		}
		respond 404
	}
}
