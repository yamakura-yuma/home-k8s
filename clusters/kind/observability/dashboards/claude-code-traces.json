    {
      "type": "timeseries",
      "id": 7,
      "title": "2. 依頼と LLM リクエストの所要時間 (p50 / p95)",
      "description": "interaction はユーザーの 1 依頼の全体、llm_request は API 呼び出し 1 回",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{name=~\"claude_code.(interaction|llm_request)\"} | quantile_over_time(duration, .5, .95) by (name)",
          "limit": 20,
          "tableType": "traces",
          "metricsQueryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*?\"(?:claude_code\\.)?([^\"]+)\".*?(?:p=([0-9.]+))?\\}$",
            "renamePattern": "$1 p$2"
          }
        }
      ]
    },
