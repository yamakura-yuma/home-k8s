{
  "uid": "claude-code-traces",
  "title": "Claude Code traces",
  "description": "Claude Code の OpenTelemetry トレースを TraceQL metrics で集計する。docs/observability/claude-code-traces.md",
  "tags": [
    "claude-code",
    "tempo"
  ],
  "editable": true,
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "",
  "timepicker": {},
  "links": [
    {
      "type": "dashboards",
      "title": "Claude Code",
      "tags": [
        "claude-code"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "tool",
        "label": "ツール",
        "datasource": {
          "type": "tempo",
          "uid": "tempo"
        },
        "query": {
          "refId": "TempoDatasourceVariableQueryEditor-VariableQuery",
          "type": 1,
          "label": "tool_name"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
