    {
      "type": "stat",
      "id": 2,
      "title": "今日のコスト",
      "description": "今日 0 時からのコスト (USD)。Claude Code が見積もる API 料金で、サブスクリプションの請求額ではない",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum (increase(claude_code_cost_usage_USD_total{orca_worktree_name=~\"$worker\", vcs_repository_name=~\"$repo\"}[$__range] anchored)) or vector(0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
