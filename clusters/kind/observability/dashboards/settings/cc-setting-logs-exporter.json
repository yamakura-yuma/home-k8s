     "format": "table",
     "url": "http://loki.observability.svc.cluster.local:3100/loki/api/v1/query_range",
     "url_options": {
      "method": "GET",
      "params": [
       {
        "key": "query",
        "value": "sum by (event_name) (count_over_time({service_name=\"claude-code\"} [5m]))"
       },
