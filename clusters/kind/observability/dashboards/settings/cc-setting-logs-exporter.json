     "type": "json",
     "source": "url",
     "parser": "backend",
     "format": "table",
     "url": "http://loki.observability.svc.cluster.local:3100/loki/api/v1/query_range",
     "url_options": {
      "method": "GET",
      "params": [
       {
        "key": "query",
        "value": "sum by (event_name, keys, rkeys) (count_over_time({service_name=\"claude-code\"} | label_format keys=`{{ range $k, $v := . }}{{ if and (ne $v \"\") (ne $v \"<REDACTED>\") }}{{ $k }} {{ end }}{{ end }}`, rkeys=`{{ range $k, $v := . }}{{ if eq $v \"<REDACTED>\" }}{{ $k }} {{ end }}{{ end }}` [5m]))"
       },
       {
        "key": "start",
        "value": "${__from:date:seconds}"
       },
       {
        "key": "end",
        "value": "${__to:date:seconds}"
       },
       {
        "key": "step",
        "value": "300"
       }
      ]
     },
     "root_selector": "( $rows := data.result.( $e := metric.event_name; $n := $sum(values.$number($[1])); $append($map($filter($split($trim($string(metric.keys)), \" \"), function($x){ $x != \"\" }), function($x){ {\"event\": $e, \"key\": $x, \"state\": \"値あり\", \"n\": $n} }), $map($filter($split($trim($string(metric.rkeys)), \" \"), function($x){ $x != \"\" }), function($x){ {\"event\": $e, \"key\": $x, \"state\": \"<REDACTED>\", \"n\": $n} })) ); $distinct($rows.(event & \"|\" & key & \"|\" & state)).( $k := $; $g := $rows[(event & \"|\" & key & \"|\" & state) = $k]; {\"event\": $g[0].event, \"key\": $g[0].key, \"state\": $g[0].state, \"count\": $sum($g.n)} ) )",
     "columns": []
    }
   ],
   "fieldConfig": {
