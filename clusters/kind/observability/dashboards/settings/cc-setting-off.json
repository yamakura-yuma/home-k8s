     },
     "root_selector": "( $rows := data.result.( $e := metric.event_name; $n := $sum(values.$number($[1])); $append($map($filter($split($trim($string(metric.keys)), \" \"), function($x){ $x != \"\" }), function($x){ {\"event\": $e, \"key\": $x, \"state\": \"値あり\", \"n\": $n} }), $map($filter($split($trim($string(metric.rkeys)), \" \"), function($x){ $x != \"\" }), function($x){ {\"event\": $e, \"key\": $x, \"state\": \"<REDACTED>\", \"n\": $n} })) ); $distinct($rows.(event & \"|\" & key & \"|\" & state)).( $k := $; $g := $rows[(event & \"|\" & key & \"|\" & state) = $k]; {\"event\": $g[0].event, \"key\": $g[0].key, \"state\": $g[0].state, \"count\": $sum($g.n)} ) )",
