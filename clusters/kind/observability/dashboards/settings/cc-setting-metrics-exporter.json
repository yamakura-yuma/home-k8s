   "description": "0 = 公式にはあるが期間中に 1 度も送られていない (PR やコミットを作っていないなど)。",
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "backend-api"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "backend-api"
     },
     "type": "json",
     "source": "url",
     "parser": "backend",
     "format": "table",
     "url": "http://prometheus-server.observability.svc.cluster.local/api/v1/series",
     "url_options": {
      "method": "GET",
      "params": [
       {
        "key": "match[]",
        "value": "{__name__=~\"claude_code_.*\"}"
       },
       {
        "key": "start",
        "value": "${__from:date:seconds}"
       },
       {
        "key": "end",
        "value": "${__to:date:seconds}"
       }
      ]
     },
     "root_selector": "( $d := data; $names := $distinct($d.__name__); $append([\"claude_code_session_count_total\", \"claude_code_lines_of_code_count_total\", \"claude_code_pull_request_count_total\", \"claude_code_commit_count_total\", \"claude_code_cost_usage_USD_total\", \"claude_code_token_usage_tokens_total\", \"claude_code_code_edit_tool_decision_total\", \"claude_code_active_time_seconds_total\"], $names[$not($ in [\"claude_code_session_count_total\", \"claude_code_lines_of_code_count_total\", \"claude_code_pull_request_count_total\", \"claude_code_commit_count_total\", \"claude_code_cost_usage_USD_total\", \"claude_code_token_usage_tokens_total\", \"claude_code_code_edit_tool_decision_total\", \"claude_code_active_time_seconds_total\"])]).( $m := $; {\"metric\": $m, \"doc\": $m in [\"claude_code_session_count_total\", \"claude_code_lines_of_code_count_total\", \"claude_code_pull_request_count_total\", \"claude_code_commit_count_total\", \"claude_code_cost_usage_USD_total\", \"claude_code_token_usage_tokens_total\", \"claude_code_code_edit_tool_decision_total\", \"claude_code_active_time_seconds_total\"] ? \"公式\" : \"公式に無い\", \"series\": $count($d[__name__ = $m])} ) )",
     "columns": []
    }
