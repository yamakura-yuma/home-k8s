              "options": "値の種類"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "metric": "メトリクス",
              "label": "ラベル",
              "n": "値の種類",
              "examples": "値の例"
            },
            "excludeByName": {},
