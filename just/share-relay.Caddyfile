# headroom の中継 (just share を常駐させる構成、docs/cluster/share.md)。ホストの docker bridge (kind) のゲートウェイで待ち受け、
# クラスタ内の share Pod から headroom (localhost:8787) のダッシュボードだけを読ませる。
# headroom は同じポートでプロキシ本体 (/v1/messages など。手元の Anthropic の認証を使って転送する) とダッシュボードを返すので、
# 8787 を bridge に出すとプロキシ本体まで bridge 上の他のコンテナから使われる。ここでは
#   1. 共有トークンのヘッダ (X-Share-Relay-Token) が無い・違う要求は、経路に関わらず 401
#   2. トークンがあっても、ダッシュボードが使う読み取りの GET だけを通し、残りは 404
# にする。設定の変更 (POST /settings、/dashboard/settings) や /stats/reset、/cache/clear も通さない。
# HEAD は通さない (#48): 実機の headroom は許可リストの経路の HEAD に 404 を返し、Anthropic へ素通しするとみられる。HEAD を使う用途は無い。
# 環境変数 (just/share-relay.sh が docker run -e で渡す): SHARE_RELAY_BIND (待ち受けるアドレス)、SHARE_RELAY_PORT、
# SHARE_RELAY_TOKEN (空なら起動しない)、SHARE_RELAY_UPSTREAM (省略時 localhost:8787。試験が偽の upstream に向ける)。
{
	admin off
	auto_https off
}

http://:{$SHARE_RELAY_PORT} {
	bind {$SHARE_RELAY_BIND}
	@unauthorized not header X-Share-Relay-Token {$SHARE_RELAY_TOKEN}
	handle @unauthorized {
		respond 401
	}
	# path の matcher は大文字小文字を区別しない (/Health も /health として通る)。headroom は区別するので、
	# 表記揺れの経路がプロキシ本体の受け口に落ちうる。許可は path_regexp (区別する・全体一致) で書く (#53)
	@dashboard {
		method GET
		path_regexp dash ^/(dashboard|health|stats|stats-history|stats-lifetime|transformations/feed|favicon\.ico)$
	}
	handle @dashboard {
		# path_regexp は caddy が整えた path に当たるが、reverse_proxy は生の path を送る。/x/../health のようなドットセグメントが
		# そのまま headroom に届かないよう、許可した経路そのものに書き換えて渡す (クエリは残る)
		rewrite * /{re.dash.1}
		reverse_proxy {$SHARE_RELAY_UPSTREAM:localhost:8787} {
			header_up -X-Share-Relay-Token
			header_up Host {upstream_hostport}
		}
	}
	handle {
		respond 404
	}
}
