# just share backstage が cloudflared と Backstage (localhost:7007) の間に挟むリバースプロキシ。
# Backstage はバックエンドのプロキシ (/api/proxy/grafana/api) で Grafana の API を、Backstage が持つ
# 資格情報で読む。7007 をそのまま出すと、それも外から使える。また catalog の POST /api/catalog/locations は
# 外からカタログに任意の URL を読ませる。ここでは画面と TechDocs を読むのに要る経路だけを通し、残りは 404 にする。
#   GET・HEAD: /api/proxy 以外はすべて (画面・カタログ・TechDocs の読み取り)
#   POST: ゲストのログイン (/api/auth/*) と、カタログのエンティティの一括取得 (/api/catalog/entities/by-refs) だけ
# 認証: 画面の API 呼び出しは Authorization: Bearer (Backstage のトークン) を付けるので、basic_auth を
# すべての要求に掛けると通らない。最初のページの読み込みで basic_auth を通ったら合言葉の cookie を渡し、
# 以後は cookie を持つ要求だけを通す。合言葉 (SHARE_SESSION) は共有のたびに作り直す。
{
	admin off
	auto_https off
}

# TechDocs の文書の CSS や画像は cookie (backstage-auth) で認証する。Backstage はその cookie に
# backend.baseUrl のホスト名 (Domain=localhost) を付けるので、trycloudflare のホストではブラウザが捨て、
# 文書が表示されない。Domain を外して、開いたホストの cookie にする
(backstage_cookie) {
	header_down Set-Cookie "; Domain=localhost" ""
}

http://:{$SHARE_PROXY_PORT} {
	bind 127.0.0.1
	@read {
		method GET HEAD
		not path /api/proxy /api/proxy/*
	}
	@write {
		method POST
		path /api/auth/* /api/catalog/entities/by-refs
	}
	@nosession not header Cookie *share_session={$SHARE_SESSION}*
	@basic header Authorization "Basic *"
	route {
		basic_auth @nosession {
			{$SHARE_USER} {$SHARE_PASSWORD_HASH}
		}
		header @nosession Set-Cookie "share_session={$SHARE_SESSION}; Path=/; HttpOnly; Secure; SameSite=Lax"
		# basic_auth の資格情報は Backstage に渡さない (Backstage は Bearer のトークンだけを見る)
		request_header @basic -Authorization
		reverse_proxy @read localhost:7007 {
			import backstage_cookie
		}
		reverse_proxy @write localhost:7007 {
			import backstage_cookie
		}
		respond 404
	}
}
